import re
import time
import random

# NORMALISE NAME
def normalise_name(name):
    return " ".join(name.lower().split())


# NORMALISE PHONE NUMBER
def normalise_phone(phone):
    digits = "".join(filter(str.isdigit, phone))

    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]
    elif len(digits) == 11 and digits.startswith("0"):
        digits = digits[1:]

    return digits


# NORMALISE EMAIL
def normalise_email(email):
    return email.strip().lower()


# DICTIONARY METHOD
def merge_contacts(contacts):
    merged = {}

    for index, contact in enumerate(contacts):
        name, phone, email = contact

        number = normalise_phone(phone)

        # Missing phone numbers are kept separate
        key = number if number else "missing_" + str(index)

        if key not in merged:
            merged[key] = {
                "name": name,
                "numbers": set(),
                "emails": set()
            }

        if number:
            merged[key]["numbers"].add(number)

        if email.strip():
            merged[key]["emails"].add(normalise_email(email))

    return list(merged.values())


# PAIRWISE COMPARISON METHOD
def pairwise_count(contacts):
    count = 0

    for i in range(len(contacts)):
        for j in range(i + 1, len(contacts)):
            count += 1

            if normalise_phone(contacts[i][1]) == normalise_phone(contacts[j][1]):
                pass

    return count


# USER INPUT
n = int(input("Enter number of contacts: "))

contacts = []

for i in range(n):
