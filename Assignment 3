    print("Phone numbers:", contact["numbers"])
    print("Emails:", contact["emails"])

print("\nTotal contacts entered:", n)
print("Unique contacts:", len(result))
print("Dictionary merging time:", dictionary_time * 1000, "ms")


# VERIFY SMALL INPUT
if n <= 20:
